---
import { stallions } from '../data/stallions';
import { horseCategories } from '../data/horses';

interface Props {
  title?: string;
  description?: string;
  navDark?: boolean;
}

const { title = 'Quarter Dream', description = "Quarter Dream SRL – NRHA Reining Horse breeders in Ostuni, Puglia. If you can dream it, you can do it.", navDark = false } = Astro.props;

const menuStallions = ['sugar-little-step', 'colonels-dancing-gun', 'hollys-hijacker']
  .map((slug) => stallions.find((s) => s.slug === slug)!);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300&display=swap" rel="stylesheet" />
    <title>{title !== 'Quarter Dream' ? `${title} | Quarter Dream` : 'Quarter Dream – NRHA Reining Horse Breeders'}</title>

    <script is:inline>
      // Netlify Identity invite/recovery links point at the bare domain;
      // only /admin loads the widget that can process the token, so bounce there.
      (function () {
        var hash = window.location.hash;
        var isIdentityToken = /invite_token=|recovery_token=|confirmation_token=|email_change_token=/.test(hash);
        if (isIdentityToken && window.location.pathname.indexOf('/admin') !== 0) {
          window.location.replace('/admin/' + hash);
        }
      })();
    </script>
  </head>
  <body>

    <!-- NAV — only over the hero, scrolls away with the first screen -->
    <header class={`navbar${navDark ? ' navbar--dark' : ''}`} id="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-logo">
          <img src="/images/logo.png" alt="Quarter Dream" />
        </a>

        <div class="navbar-right">
          <div class="navbar-social">
            <a href="https://www.instagram.com/quarter_dream/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/></svg>
            </a>
            <a href="https://www.facebook.com/p/QUARTER-DREAM-100063557504399/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>

          <button class="hamburger" id="hamburger" type="button" aria-label="Open menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- FULLSCREEN MENU -->
    <div class="menu-overlay" id="menu-overlay">
      <nav class="menu-nav menu-panel" id="menu-main">
        <a href="/about">About</a>
        <a href="/news">News</a>
        <button class="menu-toggle" type="button" id="stallions-toggle" aria-expanded="false" aria-controls="stallions-submenu">
          Stallions
        </button>
        <button class="menu-toggle" type="button" id="horses-toggle" aria-expanded="false" aria-controls="horses-submenu">
          Horses
        </button>
        <a href="/team">Team</a>
        <a href="https://store.quarterdream.com/shop/" target="_blank" rel="noopener noreferrer">Store</a>
        <a href="/contact">Contact</a>
      </nav>

      <nav class="menu-nav menu-panel menu-submenu" id="stallions-submenu">
        <button class="menu-back" type="button" id="stallions-back">&larr; Menu</button>
        {menuStallions.map((s) => (
          <a href={`/stallions/${s.slug}`}>{s.name}</a>
        ))}
      </nav>

      <nav class="menu-nav menu-panel menu-submenu" id="horses-submenu">
        <button class="menu-back" type="button" id="horses-back">&larr; Menu</button>
        {horseCategories.map((c) => (
          <a href={`/horses/${c.slug}`}>{c.label}</a>
        ))}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/">
            <img src="/images/logo.png" alt="Quarter Dream" class="footer-logo" />
          </a>
        </div>

        <div class="footer-col">
          <h4>Sede legale</h4>
          <p>Quarter Dream SRL<br />Via Baione, 200<br />70043 Monopoli (BA)<br />P. IVA 07457190721</p>
        </div>

        <div class="footer-col">
          <h4>Sede allevamento</h4>
          <p>Az. Agr. Quarter Dream di Converso Elena<br />C.da Cimino – SS 379 uscita Monticelli<br />72017 Ostuni (BR)</p>
        </div>

        <div class="footer-col">
          <h4>Contact</h4>
          <p><a href="tel:+390327037685">+39 0327 0376285</a><br /><a href="mailto:office@quarterdream.com">office@quarterdream.com</a></p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Quarter Dream SRL. All rights reserved.</p>
        <a href="https://reiningfactory.com" target="_blank" rel="noopener noreferrer" class="footer-credit">Made by ReiningFactory</a>
        <div class="footer-legal">
          <a href="/privacy">Privacy Policy</a>
          <a href="/cookie-policy">Cookie Policy</a>
        </div>
      </div>
    </footer>

    <!-- BACK TO TOP -->
    <button id="backToTop" class="back-to-top" aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M8 13V3M3 7l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      import Lenis from 'lenis';

      // Smooth inertia scrolling
      const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
      const raf = (time: number) => {
        lenis.raf(time);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);

      // Scroll-reveal: elements fade + rise into view once
      const revealEls = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      revealEls.forEach((el) => revealObserver.observe(el));

      // Section background: page background crossfades as sections scroll through
      const bgSections = document.querySelectorAll<HTMLElement>('[data-bg]');
      const bgObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const bg = (entry.target as HTMLElement).dataset.bg ?? '';
              document.body.style.setProperty('--page-bg', bg);
            }
          });
        },
        { rootMargin: '-45% 0px -45% 0px' }
      );
      bgSections.forEach((el) => bgObserver.observe(el));

      // Fit-text: scale text so it spans the full width of its container
      const fitTextEls = document.querySelectorAll<HTMLElement>('.fit-text');
      const fitText = () => {
        fitTextEls.forEach((el) => {
          const container = el.parentElement;
          if (!container) return;
          const cs = getComputedStyle(container);
          const containerWidth =
            container.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          const currentSize = parseFloat(getComputedStyle(el).fontSize);
          let newSize = currentSize * (containerWidth / el.scrollWidth);

          // Optional cap so tall/wide fonts (e.g. script) don't blow past the screen
          const maxHeightVh = parseFloat(el.dataset.maxHeight ?? '');
          if (!Number.isNaN(maxHeightVh)) {
            const maxHeightPx = (window.innerHeight * maxHeightVh) / 100;
            const heightPerPx = el.getBoundingClientRect().height / currentSize;
            newSize = Math.min(newSize, maxHeightPx / heightPerPx);
          }

          el.style.fontSize = `${newSize}px`;
        });
        // Text resizing can change section heights (e.g. the script "Owner"
        // title), which Lenis needs to know about or its virtual scroll
        // height goes stale and leaves a gap between sections.
        lenis.resize();
      };
      document.fonts.ready.then(fitText);
      window.addEventListener('resize', fitText);

      // Pin sections: become fixed the instant they're reached (zero dwell),
      // exactly matching the hero, so every section covers the previous one
      // the same way. Toggled at the exact scroll position where the static
      // and fixed renderings coincide, so there's no visual jump.
      const pinEls = document.querySelectorAll<HTMLElement>('[data-pin-el]');
      const updatePins = () => {
        if (window.innerWidth <= 900) return;
        pinEls.forEach((el) => {
          const name = el.dataset.pinEl;
          const refClass = el.dataset.pinRef;
          const ref = refClass ? document.querySelector<HTMLElement>(`.${refClass}`) : null;
          if (!ref) return;
          const threshold = ref.offsetTop + ref.offsetHeight;
          const pinned = window.scrollY >= threshold;
          el.classList.toggle('is-pinned', pinned);
          const compensator = document.querySelector<HTMLElement>(`[data-pin-compensator="${name}"]`);
          compensator?.classList.toggle('is-pinned', pinned);
        });
      };
      window.addEventListener('scroll', updatePins, { passive: true });
      window.addEventListener('resize', updatePins);
      updatePins();

      // Back to top
      const backToTop = document.getElementById('backToTop');
      const updateBackToTop = () => {
        backToTop?.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
      };
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      updateBackToTop();
      backToTop?.addEventListener('click', () => lenis.scrollTo(0, { duration: 1.4 }));

      // Fullscreen menu
      const hamburger = document.getElementById('hamburger');
      const menuOverlay = document.getElementById('menu-overlay');

      const closeMenu = () => {
        hamburger?.classList.remove('is-open');
        hamburger?.setAttribute('aria-expanded', 'false');
        menuOverlay?.classList.remove('is-open');
        menuOverlay?.classList.remove('show-stallions');
        menuOverlay?.classList.remove('show-horses');
        lenis.start();
      };

      const openMenu = () => {
        hamburger?.classList.add('is-open');
        hamburger?.setAttribute('aria-expanded', 'true');
        menuOverlay?.classList.add('is-open');
        lenis.stop();
      };

      hamburger?.addEventListener('click', () => {
        if (hamburger.classList.contains('is-open')) closeMenu();
        else openMenu();
      });

      menuOverlay?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Stallions submenu panel
      const stallionsToggle = document.getElementById('stallions-toggle');
      const stallionsBack = document.getElementById('stallions-back');

      stallionsToggle?.addEventListener('click', () => {
        menuOverlay?.classList.add('show-stallions');
        stallionsToggle.setAttribute('aria-expanded', 'true');
      });

      stallionsBack?.addEventListener('click', () => {
        menuOverlay?.classList.remove('show-stallions');
        stallionsToggle?.setAttribute('aria-expanded', 'false');
      });

      // Horses submenu panel
      const horsesToggle = document.getElementById('horses-toggle');
      const horsesBack = document.getElementById('horses-back');

      horsesToggle?.addEventListener('click', () => {
        menuOverlay?.classList.add('show-horses');
        horsesToggle.setAttribute('aria-expanded', 'true');
      });

      horsesBack?.addEventListener('click', () => {
        menuOverlay?.classList.remove('show-horses');
        horsesToggle?.setAttribute('aria-expanded', 'false');
      });
    </script>
  </body>
</html>

<style is:global>
  /* =====================
     FONTS
  ===================== */
  @font-face {
    font-family: 'Brittany Signature';
    src: url('/fonts/BrittanySignature.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Gotham';
    src: url('/fonts/Gotham-Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Gotham';
    src: url('/fonts/Gotham-Black.otf') format('opentype');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  /* =====================
     TOKENS — Quarter Dream brand identity
  ===================== */
  :root {
    --gold:       #E8B369;
    --gold-dark:  #C99A52;
    --black:      #000000;
    --ink:        #141414;
    --gray-dk:    #444444;
    --gray:       #767676;
    --off-white:  #F7F6F4;
    --white:      #FFFFFF;
    --border:     #EAEAEA;

    --font-display: 'Bebas Neue', sans-serif;
    --font-body:    'Bebas Neue', sans-serif;
    --font-script:  'Brittany Signature', cursive;
    --font-gotham:  'Gotham', sans-serif;
    --font-thin:    'Montserrat', sans-serif;

    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --trans: 0.25s var(--ease);
    --trans-slow: 0.5s var(--ease);

    --nav-h: 92px;
    --max-w: 1320px;
    --px: 48px;

    --page-bg: var(--white);
  }

  /* =====================
     RESET
  ===================== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; }

  body {
    background: var(--page-bg);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    transition: background-color 0.8s var(--ease);
  }

  /* =====================
     LENIS SMOOTH SCROLL
  ===================== */
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-stopped { overflow: hidden; }

  /* =====================
     SCROLL-REVEAL
  ===================== */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  img { max-width: 100%; height: auto; display: block; }
  a { text-decoration: none; color: inherit; }
  button { background: none; border: none; cursor: pointer; font: inherit; }

  h1, h2, h3, h4, h5 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
  }

  /* =====================
     NAVBAR — only part of the first screen, scrolls away with the hero
  ===================== */
  .navbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 2500;
    background: transparent;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--px);
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: -16px;
  }

  .navbar-logo img { width: 40px; height: auto; }

  .navbar-social {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .navbar-social a {
    color: var(--white);
    display: flex;
    transition: color var(--trans), transform var(--trans);
  }

  .navbar-social a:hover {
    color: var(--gold);
    transform: translateY(-1px);
  }

  .navbar--dark .navbar-social a { color: var(--black); }
  .navbar--dark .hamburger span { background: var(--black); }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .hamburger {
    position: relative;
    z-index: 2001;
    width: 32px;
    height: 22px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--white);
    transition: transform 0.35s var(--ease), opacity 0.35s var(--ease), background 0.35s var(--ease);
  }

  .hamburger.is-open span {
    background: var(--white);
  }

  .hamburger.is-open span:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }

  .hamburger.is-open span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open span:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  /* =====================
     FULLSCREEN MENU
  ===================== */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background:
      linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)),
      url('/images/menu-bg.jpg') center / cover no-repeat;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s var(--ease), visibility 0.4s;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .menu-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--px);
    row-gap: 20px;
    column-gap: 48px;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease), visibility 0.35s;
  }

  .menu-panel a,
  .menu-toggle,
  .menu-back {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    color: var(--white);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color var(--trans);
  }

  .menu-panel a:hover,
  .menu-toggle:hover,
  .menu-back:hover {
    color: var(--gold);
  }

  .menu-submenu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(24px);
  }

  .menu-back {
    width: 100%;
    text-align: center;
    color: rgba(255,255,255,0.6);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    letter-spacing: 1.5px;
    margin-bottom: 8px;
  }

  .menu-overlay.show-stallions #menu-main,
  .menu-overlay.show-horses #menu-main {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-24px);
  }

  .menu-overlay.show-stallions #stallions-submenu,
  .menu-overlay.show-horses #horses-submenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  @media (max-width: 900px) {
    .navbar-right { gap: 18px; }
    .menu-panel {
      flex-direction: column;
      column-gap: 0;
      row-gap: 16px;
    }
  }

  /* =====================
     FOOTER
  ===================== */
  .footer {
    position: relative;
    z-index: 4;
    background: var(--black);
    color: var(--white);
  }

  .footer-top {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 72px var(--px) 56px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-logo { width: 120px; }

  .footer-col h4 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }

  .footer-col p {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
  }

  .footer-col a:hover { color: var(--white); }

  .footer-bottom {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 24px var(--px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.35);
  }

  .footer-credit {
    justify-self: center;
    color: rgba(255,255,255,0.35);
    text-decoration: none;
    transition: color var(--trans);
  }

  .footer-credit:hover {
    color: var(--gold);
  }

  .footer-legal {
    justify-self: end;
  }

  .footer-legal { display: flex; gap: 24px; }
  .footer-legal a:hover { color: rgba(255,255,255,0.7); }

  /* =====================
     BACK TO TOP
  ===================== */
  .back-to-top {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 200;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 50%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--trans), transform var(--trans), visibility var(--trans), background var(--trans), color var(--trans);
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background: var(--gold);
    color: var(--black);
  }

  @media (max-width: 768px) {
    .back-to-top {
      right: 16px;
      bottom: 16px;
      width: 42px;
      height: 42px;
    }
  }

  /* =====================
     SHARED UTILITIES
  ===================== */
  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--px);
  }

  .section {
    padding: 100px var(--px);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 14px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: var(--black);
    margin-bottom: 32px;
  }

  .gold-bar {
    display: block;
