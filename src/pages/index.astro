---
import Layout from '../layouts/Layout.astro';
import { stallions } from '../data/stallions';
import { getCollection } from 'astro:content';

const stallionBySlug = (slug: string) => stallions.find((s) => s.slug === slug)!;

const newsEntries = await getCollection('news');
const news = newsEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    ...entry.data,
    slug: entry.id,
    date: entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
  }));
---

<Layout title="Home">
  <!-- HERO — pinned in place while the next screen rises over it -->
  <div class="hero-spacer" aria-hidden="true"></div>
  <section class="hero" data-hero>
    <div class="hero-bg">
      <img src="/images/home-hero.jpg" alt="Quarter Dream" />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-content">
      <img src="/images/logo.png" alt="Quarter Dream" class="hero-logo" />
      <p class="hero-slogan">if you can dream it, you can do it.</p>
    </div>

    <div class="hero-scroll">
      <span class="hero-scroll-line"></span>
      <span class="hero-scroll-label">Scroll</span>
    </div>
  </section>

  <!-- ACHIEVEMENT BAND — becomes fixed the instant it's reached, exactly like the hero -->
  <section class="achieve" data-pin-el="achieve" data-pin-ref="hero-spacer">
    <span class="achieve-label reveal">Breeding Excellence</span>

    <h2 class="achieve-title-wrap">
      <span class="achieve-title-line fit-text reveal" style="transition-delay: 0.1s">NRHA Million Dollar</span>
      <span class="achieve-title-script fit-text reveal" data-max-height="26" style="transition-delay: 0.2s">Owner</span>
    </h2>

    <span class="achieve-meta reveal" style="transition-delay: 0.3s">Ostuni, Puglia &middot; Established 2008</span>
  </section>
  <div class="pin-compensator" data-pin-compensator="achieve" aria-hidden="true"></div>

  <!-- LATEST NEWS -->
  <section class="content-section news-section">
    <div class="content-inner">
      <div class="news-header">
        <h2 class="news-title reveal">Latest <span>News</span></h2>
        <a href="/news" class="news-link reveal">View All News</a>
      </div>

      <div class="news-grid">
        {news.slice(0, 3).map((item, i) => (
          <article class={`news-card reveal${i === 0 ? ' news-card-featured' : ''}`} style={`transition-delay: ${0.1 + i * 0.1}s`}>
            <a href={`/news/${item.slug}`}>
              <img src={item.image} alt={item.title} />
              <div class="news-overlay"></div>
              <div class="news-card-content">
                <span class="news-date">{item.date}</span>
                <h3>{item.title}</h3>
                {i === 0 && item.excerpt && <p>{item.excerpt}</p>}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SPONSORS -->
  <section class="sponsor-band">
    <div class="sponsor-track">
      {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n, i) => (
        <div class="sponsor-slot has-logo reveal" style={`transition-delay: ${i * 0.08}s`}>
          <img src={`/images/sponsors/sponsor-${n}.png`} alt="Sponsor" />
        </div>
      ))}
    </div>
  </section>

  <!-- OUR STALLIONS -->
  <section class="content-section stallions-section">
    <div class="content-inner">
      <h2 class="stallions-title-wrap">
        <span class="stallions-title-big fit-text reveal" data-max-height="18">Stallions</span>
      </h2>

      <div class="stallions-grid">
        {['sugar-little-step', 'colonels-dancing-gun', 'hollys-hijacker'].map((slug, i) => (
          <a href={`/stallions/${slug}`} class="stallion-card reveal" style={`transition-delay: ${0.1 + i * 0.1}s`}>
            <img src={stallionBySlug(slug).portrait} alt={stallionBySlug(slug).name} />
            <div class="news-overlay"></div>
            <div class="news-card-content stallion-card-content">
              <h3>{stallionBySlug(slug).name}</h3>
              <p set:html={`${stallionBySlug(slug).pedigree.sire} <span>x</span> ${stallionBySlug(slug).pedigree.dam}`} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =====================
     HERO
  ===================== */
  .hero-spacer {
    height: 100vh;
    min-height: 640px;
  }

  .hero {
    position: fixed;
    inset: 0;
    z-index: 0;
    height: 100vh;
    min-height: 640px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg { position: absolute; inset: 0; z-index: -1; }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.2) 35%, rgba(0,0,0,0.55) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    text-align: center;
    padding: 0 24px;
  }

  .hero-logo {
    width: clamp(140px, 20vw, 260px);
    margin: 0 auto 32px;
    filter: drop-shadow(0 4px 24px rgba(0,0,0,0.4));
  }

  .hero-slogan {
    font-family: var(--font-script);
    font-size: clamp(1.3rem, 6vw, 3.8rem);
    color: var(--gold);
    text-shadow: 0 4px 24px rgba(0,0,0,0.35);
    white-space: nowrap;
  }

  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 10;
  }

  .hero-scroll-line {
    width: 1px;
    height: 48px;
    background: rgba(255,255,255,0.5);
  }

  .hero-scroll-label {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }

  /* =====================
     ACHIEVEMENT BAND
  ===================== */
  .achieve {
    position: relative;
    z-index: 1;
    height: 100vh;
    min-height: 640px;
    background: var(--gold);
    color: var(--white);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 0;
    overflow: hidden;
    box-shadow: 0 -24px 60px rgba(0,0,0,0.25);
  }

  .achieve.is-pinned {
    position: fixed;
    inset: 0;
  }

  .pin-compensator {
    height: 0;
  }

  .pin-compensator.is-pinned {
    height: 100vh;
    min-height: 640px;
  }

  .achieve-label {
    font-family: var(--font-body);
    font-size: 1.2rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    display: block;
    margin-bottom: 56px;
    padding: 0 var(--px);
  }

  .achieve-title-wrap {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 3vw;
    margin-bottom: 40px;
  }

  .achieve-title-line,
  .achieve-title-script {
    display: block;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    white-space: nowrap;
    line-height: 1;
    color: var(--white);
  }

  .achieve-title-line {
    font-family: var(--font-body);
    text-transform: uppercase;
    font-size: 4rem;
  }

  .achieve-title-script {
    font-family: var(--font-script);
    font-size: 6rem;
    margin-top: 36px;
  }

  .achieve-meta {
    margin-top: 96px;
    padding: 0 var(--px);
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
  }

  /* =====================
     CONTENT SECTIONS — News / Stallions (white)
  ===================== */
  .content-section {
    position: relative;
    z-index: 2;
    background: var(--white);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .content-inner {
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 56px var(--px);
  }

  /* ---- Section header (title + "view all" link), shared by News/Stallions ---- */
  .news-header {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 calc(3vw + 14px);
    margin-bottom: 32px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }

  .news-title {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    color: var(--black);
  }

  .news-title span { color: var(--gold); }

  .stallions-title-wrap {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 3vw;
    margin-bottom: 32px;
  }

  .stallions-title-big {
    display: block;
    width: fit-content;
    margin: 0 auto;
    white-space: nowrap;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gold);
    font-size: 8rem;
    line-height: 0.95;
  }

  .stallions-section {
    justify-content: flex-start;
  }

  .news-link {
    flex-shrink: 0;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.95rem;
    color: var(--gold-dark);
    border-bottom: 1px solid transparent;
    transition: color var(--trans), border-color var(--trans);
  }

  .news-link:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  /* ---- News grid ---- */
  .news-grid {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 3vw;
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
    height: 560px;
    margin-bottom: 32px;
  }

  .news-card {
    position: relative;
    overflow: hidden;
    background: var(--black);
    border-radius: 16px;
  }

  .news-card-featured { grid-row: 1 / 3; }

  .news-card a { display: block; height: 100%; }

  .news-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform var(--trans-slow);
  }

  .news-card:hover img { transform: scale(1.04); }

  .news-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,0.85) 100%);
  }

  .news-card-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 22px;
    color: var(--white);
  }

  .news-card-featured .news-card-content { padding: 32px; }

  .news-date {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--black);
    background: var(--gold);
    border-radius: 999px;
    padding: 5px 16px;
    margin-bottom: 14px;
  }

  .news-card-content h3 {
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--white);
  }

  .news-card-featured .news-card-content h3 { font-size: 2.4rem; margin-bottom: 12px; }

  .news-card-featured .news-card-content p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.85);
    max-width: 480px;
  }

  /* =====================
     SPONSORS
  ===================== */
  .sponsor-band {
    position: relative;
    z-index: 2;
    background: var(--gold);
    padding: 36px var(--px);
  }

  .sponsor-track {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 48px;
  }

  .sponsor-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 160px;
    height: 80px;
    background: rgba(255,255,255,0.25);
    border: 1px dashed rgba(255,255,255,0.6);
    border-radius: 8px;
    font-family: var(--font-body);
    letter-spacing: 2px;
    color: rgba(255,255,255,0.85);
  }

  .sponsor-slot.has-logo {
    background: none;
    border: none;
  }

  .sponsor-slot.has-logo.on-white {
    background: var(--white);
    border-radius: 10px;
    padding: 12px 20px;
  }

  .sponsor-slot.has-logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* ---- Stallions grid (same visual language as news cards) ---- */
  .stallions-grid {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 3vw;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .stallion-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--black);
    border-radius: 16px;
    aspect-ratio: 400 / 566;
  }

  .stallion-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--trans-slow);
  }

  .stallion-card:hover img { transform: scale(1.04); }

  .stallion-card-content {
    text-align: center;
  }

  .stallion-card .news-card-content h3 {
    font-family: var(--font-display);
    text-transform: none;
    font-size: 1.6rem;
    margin-bottom: 6px;
  }

  .stallion-card .news-card-content p {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.85);
  }

  .stallion-card .news-card-content p span {
    color: var(--gold);
  }

  /* =====================
     MOBILE
  ===================== */
  @media (max-width: 900px) {
    .hero-spacer,
    .pin-compensator {
      display: none;
    }

    .hero,
    .achieve,
    .achieve.is-pinned {
      position: static;
      inset: auto;
      height: auto;
      min-height: 100vh;
      overflow: visible;
      box-shadow: none;
    }

    .content-inner { padding: 72px var(--px); }

    .news-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .news-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
    }

    .news-card { height: 260px; }
    .news-card-featured { grid-row: auto; height: 320px; }

    .sponsor-band { padding: 48px var(--px); }
    .sponsor-track { gap: 28px; }
    .sponsor-slot { width: 130px; height: 64px; }

    .stallions-grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
