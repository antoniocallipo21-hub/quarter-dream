---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Quarter Dream, NRHA reining horse breeders in Ostuni, Puglia.">
  <!-- HERO -->
  <section class="contact-hero">
    <h1 class="contact-hero-title reveal">Contact</h1>
  </section>

  <!-- CONTACT BODY -->
  <section class="contact-body">
    <div class="contact-inner">
      <div class="contact-info reveal">
        <h2 class="contact-info-title">Get In Touch</h2>
        <p class="contact-info-text">
          Whether you're interested in our stallions, breeding services, or just want to say hello, we'd love to hear from you.
        </p>

        <div class="contact-block">
          <span class="contact-label">Registered Office</span>
          <p>Quarter Dream SRL<br />Via Baione, 200<br />70043 Monopoli (BA)<br />P. IVA 07457190721</p>
        </div>

        <div class="contact-block">
          <span class="contact-label">Breeding Farm</span>
          <p>Az. Agr. Quarter Dream di Converso Elena<br />C.da Cimino &ndash; SS 379 uscita Monticelli<br />72017 Ostuni (BR)</p>
        </div>

        <div class="contact-block">
          <span class="contact-label">Contact</span>
          <p>
            <a href="tel:+393270376285">+39 327 0376285</a><br />
            <a href="mailto:office@quarterdream.com">office@quarterdream.com</a>
          </p>
        </div>

        <div class="contact-social">
          <a href="https://www.instagram.com/quarter_dream/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/></svg>
          </a>
          <a href="https://www.facebook.com/p/QUARTER-DREAM-100063557504399/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      <div class="contact-form-wrap reveal" style="transition-delay: 0.1s">
        <!-- TODO: replace with real Formspree endpoint (https://formspree.io/f/YOUR_FORM_ID) -->
        <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="form-row">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="form-row">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="form-row">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" />
          </div>

          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <button type="submit" class="form-submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =====================
     HERO
  ===================== */
  .contact-hero {
    position: relative;
    height: 38vh;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.72)),
      url('/images/contact-hero.jpg') center / cover no-repeat;
  }

  .contact-hero-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    color: var(--white);
  }

  /* =====================
     BODY
  ===================== */
  .contact-body {
    background: var(--white);
    padding: 88px var(--px) 110px;
  }

  .contact-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    column-gap: 80px;
  }

  .contact-info-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--black);
    margin-bottom: 16px;
  }

  .contact-info-text {
    font-family: var(--font-thin);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--gray-dk);
    margin-bottom: 40px;
    max-width: 420px;
  }

  .contact-block {
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }

  .contact-block:last-of-type {
    border-bottom: 1px solid var(--border);
  }

  .contact-label {
    display: block;
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.75rem;
    color: var(--gold-dark);
    margin-bottom: 10px;
  }

  .contact-block p {
    font-family: var(--font-thin);
    font-weight: 300;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .contact-block a {
    color: var(--ink);
    text-decoration: none;
  }

  .contact-block a:hover {
    color: var(--gold-dark);
  }

  .contact-social {
    display: flex;
    gap: 20px;
    margin-top: 28px;
  }

  .contact-social a {
    color: var(--black);
    display: flex;
    transition: color var(--trans, 0.25s ease);
  }

  .contact-social a:hover {
    color: var(--gold-dark);
  }

  /* =====================
     FORM
  ===================== */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-row label {
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.75rem;
    color: var(--gray);
  }

  .form-row input,
  .form-row textarea {
    font-family: var(--font-thin);
    font-weight: 300;
    font-size: 1rem;
    color: var(--ink);
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 10px 2px;
    background: transparent;
    resize: vertical;
    transition: border-color 0.25s ease;
  }

  .form-row input:focus,
  .form-row textarea:focus {
    outline: none;
    border-color: var(--gold);
  }

  .form-submit {
    align-self: flex-start;
    margin-top: 10px;
    padding: 16px 36px;
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.85rem;
    color: var(--white);
    background: var(--black);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .form-submit:hover {
    background: var(--gold-dark);
  }

  @media (max-width: 900px) {
    .contact-inner {
      grid-template-columns: 1fr;
      row-gap: 56px;
    }
  }
</style>
