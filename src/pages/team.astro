---
import Layout from '../layouts/Layout.astro';

const team = [
  { name: 'Team Member', role: 'Role', image: '' },
  { name: 'Team Member', role: 'Role', image: '' },
  { name: 'Team Member', role: 'Role', image: '' },
];
---

<Layout title="Team">
  <!-- HERO -->
  <section class="team-hero">
    <h1 class="team-hero-title reveal">Team</h1>
  </section>

  <!-- TEAM GRID -->
  <section class="team-body">
    <div class="team-inner">
      <div class="team-grid">
        {team.map((person, i) => (
          <div class="team-card reveal" style={`transition-delay: ${0.05 + i * 0.1}s`}>
            <div class="team-card-photo">
              {person.image && <img src={person.image} alt={person.name} />}
            </div>
            <h3 class="team-card-name">{person.name}</h3>
            <span class="team-card-role">{person.role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =====================
     HERO
  ===================== */
  .team-hero {
    position: relative;
    height: 38vh;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.72)),
      url('/images/team-hero.jpg') center / cover no-repeat;
  }

  .team-hero-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    color: var(--white);
  }

  /* =====================
     BODY
  ===================== */
  .team-body {
    background: var(--white);
    padding: 88px var(--px) 110px;
  }

  .team-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .team-card {
    text-align: center;
  }

  .team-card-photo {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--off-white);
    margin-bottom: 20px;
  }

  .team-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-card-name {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 1.3rem;
    color: var(--black);
    margin-bottom: 6px;
  }

  .team-card-role {
    display: block;
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.75rem;
    color: var(--gold-dark);
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
