---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, date, image, excerpt, gallery } = entry.data;
const { Content } = await render(entry);

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={title} navDark={true}>
  <!-- BODY -->
  <section class="article-body">
    <div class="article-inner">
      <a href="/news" class="article-back reveal">&larr; Back to News</a>

      <span class="article-date reveal">{formattedDate}</span>
      <h1 class="article-title reveal" style="transition-delay: 0.05s">{title}</h1>

      <div class="article-main-photo reveal" style="transition-delay: 0.1s">
        <img src={image} alt={title} />
      </div>

      {excerpt && <p class="article-excerpt reveal" style="transition-delay: 0.15s">{excerpt}</p>}

      <div class="article-content reveal" style="transition-delay: 0.2s">
        <Content />
      </div>

      {gallery && gallery.length > 0 && (
        <div class="article-gallery reveal" style="transition-delay: 0.25s">
          {gallery.map((src, i) => (
            <button type="button" class="article-gallery-item" data-lightbox-src={src} data-lightbox-index={i}>
              <img src={src} alt={title} loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
  </section>

  {gallery && gallery.length > 0 && (
    <div class="lightbox" id="lightbox">
      <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
      {gallery.length > 1 && (
        <button type="button" class="lightbox-arrow lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8249;</button>
      )}
      <img src="" alt={title} id="lightbox-img" />
      {gallery.length > 1 && (
        <button type="button" class="lightbox-arrow lightbox-next" id="lightbox-next" aria-label="Next">&#8250;</button>
      )}
    </div>
  )}
</Layout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.article-gallery-item'));
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  let currentIndex = 0;

  const sources = items.map((item) => item.dataset.lightboxSrc || '');

  const openLightbox = (index: number) => {
    if (!lightbox || !lightboxImg || sources.length === 0) return;
    currentIndex = (index + sources.length) % sources.length;
    lightboxImg.src = sources[currentIndex];
    lightbox.classList.add('is-open');
  };

  const closeLightbox = () => {
    lightbox?.classList.remove('is-open');
  };

  items.forEach((item) => {
    item.addEventListener('click', () => {
      openLightbox(Number(item.dataset.lightboxIndex));
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => openLightbox(currentIndex - 1));
  nextBtn?.addEventListener('click', () => openLightbox(currentIndex + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') openLightbox(currentIndex + 1);
  });
</script>

<style>
  /* =====================
     BODY
  ===================== */
  .article-body {
    background: var(--white);
    padding: calc(var(--nav-h) + 48px) var(--px) 110px;
  }

  .article-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .article-back {
    display: inline-block;
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.8rem;
    color: var(--gray);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.25s var(--ease);
  }

  .article-back:hover {
    color: var(--gold-dark);
  }

  .article-date {
    display: block;
    font-family: var(--font-gotham);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.8rem;
    color: var(--gold-dark);
    margin-bottom: 14px;
  }

  .article-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--black);
    margin-bottom: 32px;
  }

  .article-main-photo {
    width: 100%;
    max-height: 70vh;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 32px;
    display: flex;
    justify-content: center;
    background: var(--off-white);
  }

  .article-main-photo img {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    display: block;
  }

  .article-excerpt {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--black);
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .article-content {
    font-family: var(--font-thin);
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .article-content :global(p) {
    margin-bottom: 24px;
  }

  .article-content :global(h2),
  .article-content :global(h3) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--black);
    margin: 40px 0 16px;
  }

  .article-content :global(img) {
    width: 100%;
    border-radius: 12px;
    margin: 32px 0;
  }

  .article-content :global(a) {
    color: var(--gold-dark);
  }

  /* =====================
     GALLERY
  ===================== */
  .article-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .article-gallery-item {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.25s var(--ease);
  }

  .article-gallery-item:hover {
    opacity: 0.85;
  }

  .article-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* =====================
     LIGHTBOX
  ===================== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(0,0,0,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s var(--ease), visibility 0.3s;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox img {
    max-width: 88vw;
    max-height: 86vh;
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: var(--white);
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--white);
    font-size: 3rem;
    line-height: 1;
    cursor: pointer;
    padding: 12px;
  }

  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }

  @media (max-width: 900px) {
    .lightbox-arrow { font-size: 2rem; }
    .lightbox-close { font-size: 2rem; top: 16px; right: 16px; }
  }
</style>
